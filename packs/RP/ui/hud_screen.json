{
  "iwnt_blink_mechanic_appear": {
    "anim_type": "alpha",
    "easing": "in_cubic",
    "from": 0.0,
    "to": 1.0,
    "duration": 0.55,
    "next": "@hud.iwnt_blink_mechanic_wait"
  },
  "iwnt_blink_mechanic_wait": {
    "anim_type": "wait",
    "duration": 0.65,
    "next": "@hud.iwnt_blink_mechanic_disappear"
  },
  "iwnt_blink_mechanic_disappear": {
    "anim_type": "alpha",
    "easing": "out_cubic",
    "from": 1.0,
    "to": 0.0,
    "duration": 0.35,
    "destroy_at_end": "iwnt_blink_mechanic"
  },
  "iwnt_blink_mechanic": {
    "type": "image",
    "texture": "textures/ui/Black",
    "size": [
      "100%",
      "100%"
    ],
    "anims": [
      "@hud.iwnt_blink_mechanic_appear"
    ],
    "bindings": [
      {
        "binding_name": "#hud_title_text_string",
        "binding_type": "global"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#hud_title_text_string = 'iwnt_blink')",
        "target_property_name": "#visible"
      }
    ]
  },
  "iwnt_blink_factory": {
    "type": "panel",
    "factory": {
      "name": "hud_title_text_factory",
      "control_ids": {
        "hud_title_text": "iwnt_blink_mechanic@hud.iwnt_blink_mechanic"
      }
    }
  },
  "hud_title_text/title_frame/title": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          {
            "binding_type": "view",
            "source_property_name": "(not (#text = 'iwnt_blink'))",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  },
  "hud_screen": {
    "$screen_bg_content": "hud.iwnt_blink_factory"
  }
}