{
  "hud_title_text/title_frame/title": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          {
            "binding_type": "view",
            "source_property_name": "((#text - $iwnt_blink_visible_name - $iwnt_blur_visible_name - $iwnt_msg_popup_visible_name - $iwnt_msg_popup_update_name) = #text)",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  },
  "hud_screen_bg_content": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "blink_mechanic_factory@iwnt_blink_mechanic.iwnt_blink_factory": {
          "layer": 1 // Above the message pop-up factory
        }
      },
      {
        "iwnt_blink_data_control@iwnt_blink_mechanic.iwnt_blink_data_control": {}
      },
      {
        "blur_mechanic_image@iwnt_blink_mechanic.iwnt_blur_image": {}
      },
      {
        "iwnt_msg_popup_factory@iwnt_msg_popup_mechanic.iwnt_msg_popup_factory": {}
      },
      {
        "iwnt_msg_popup_data_control@iwnt_msg_popup_mechanic.iwnt_msg_popup_data_control": {}
      }
    ],
    "bindings": [
      {
        "binding_name": "(not #on_new_death_screen)",
        "binding_name_override": "#visible"
      }
    ]
  },
  "hud_screen": {
    "$screen_bg_content": "hud.hud_screen_bg_content"
  }
}