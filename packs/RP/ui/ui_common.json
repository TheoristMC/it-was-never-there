{
  "highlight_slot_panel/highlight/hover_text": {
    "bindings": [
      {
        "binding_name": "$hover_text_binding_name",
        "binding_name_override": "#default_hover_text",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#default_hover_text - $iwnt_randomUselessItem_flag)",
        "target_property_name": "#hover_text"
      }
    ]
  },
  "item_text_label": {
    "text": "#text",
    "bindings": [
      {
        "binding_type": "view",
        "source_property_name": "(#selected_hover_text - $iwnt_randomUselessItem_flag)",
        "target_property_name": "#text"
      }
    ]
  }
}